{ pkgs, ... }:

{
  # Install arandr and autorandr
  environment.systemPackages = with pkgs; [
    arandr
    autorandr
  ];

  # autorandr config
  services.autorandr = {
    enable = true;
    
    # Configure profiles
    profiles = {
      laptop = {
        fingerprint = {
          eDP-1 = "";
        };
        config = {
          eDP-1 = {
            enable = true;
            position = "0x0";
            mode = "2560x1600";
            rate = "60.00";
          };
        };
      };

      home-1 = {
        fingerprint = {
          eDP-1 = "";
          HDMI-1-1 = "";
        };
        config = {
          eDP-1 = {
            enable = true;
            position = "0x560";
            mode = "2560x1600";
            rate = "60.00";
          };
          HDMI-1-1 = {
            enable = true;
            primary = true;
            position = "2560x0";
            mode = "3840x2160";
            rate = "60.00";
          };
        };
      };

      home-2 = {
        fingerprint = {
          eDP-1 = "";
          HDMI-1-1 = "";
        };
        config = {
          eDP-1.enable = false;

          HDMI-1-1 = {
            enable = true;
            primary = true;
            position = "0x0";
            mode = "3840x2160";
            rate = "60.00";
          };
        };
      };

      ni-1 = {
        fingerprint = {
          eDP-1 = "";
          HDMI-1-1 = "";
        };

        config = {
          eDP-1 = {
            enable = true;
            primary = true;
            position = "0x1080";
            mode = "2560x1600";
            rate = "60.00";
          };

          HDMI-1-1 = {
            enable = true;
            position = "320x0";
            mode = "1920x1080";
            rate = "60.00";
          };
        };
      };

      specs-1 = {
        fingerprint = {
          eDP-1 = "";
          HDMI-1-1 = "";
        };

        config = {
          eDP-1 = {
            enable = true;
            primary = true;
            position = "0x1080";
            mode = "2560x1600";
            rate = "60.00";
          };

          HDMI-1-1 = {
            enable = true;
            position = "320x0";
            mode = "1920x1080";
            rate = "60.00";            
          };
        };
      };
    };
  };
}